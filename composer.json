{
	"name": "sergioooo/phpagi",
	"description": "PHPAGI is a PHP Class for writing AGI applications for use with the open source Asterisk PBX software.",
	"license": "GPL-2.0-or-later",
	"autoload": {
		"classmap": [
			"src/AGI.php",
			"src/AGI_AsteriskManager.php",
			"src/AGI_ChannelState.php"
		],
		"files": [
			"src/constants.php"
		]
	},
	"require": {
		"php": "^8.1",
		"composer-runtime-api": "^2.2"
	},
	"scripts": {
		"test": "php tests/compatibility.php"
	},
	"bin": [
		"bin/fastagi.php"
	]
}
